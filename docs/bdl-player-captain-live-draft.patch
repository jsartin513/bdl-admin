+import 'server-only'
+
+const SYNC_HEADER = 'x-bdl-player-sync-secret'
+
+export type CaptainDraftListResponse = {
+  version: 1
+  events: Array<{
+    eventId: string
+    eventName: string
+    eventDate: string
+    status: string
+  }>
+}
+
+export function readAdminApiBaseUrl(): string | null {
+  const catalog = process.env.NEXT_PUBLIC_LEAGUE_CATALOG_URL?.trim()
+  if (catalog) {
+    const withoutPath = catalog.replace(/\/api\/public\/leagues\/?$/i, '')
+    if (withoutPath) return withoutPath.replace(/\/$/, '')
+  }
+  const explicit = process.env.ADMIN_API_BASE_URL?.trim().replace(/\/$/, '')
+  return explicit || null
+}
+
+function readSyncSecret(): string | null {
+  const secret = process.env.PLAYER_SYNC_SECRET?.trim()
+  return secret || null
+}
+
+export function adminLiveDraftConfigured(): boolean {
+  return Boolean(readAdminApiBaseUrl() && readSyncSecret())
+}
+
+function identityHeaders(input: { email: string; accountId?: string | null }) {
+  const secret = readSyncSecret()
+  if (!secret) throw new Error('PLAYER_SYNC_SECRET is not configured')
+  const headers: Record<string, string> = {
+    [SYNC_HEADER]: secret,
+    'x-bdl-player-email': input.email.trim().toLowerCase(),
+  }
+  if (input.accountId) {
+    headers['x-bdl-player-account-id'] = input.accountId
+  }
+  return headers
+}
+
+export async function fetchCaptainDraftList(input: {
+  email: string
+  accountId?: string | null
+}): Promise<CaptainDraftListResponse> {
+  const base = readAdminApiBaseUrl()
+  if (!base) throw new Error('Admin API base URL is not configured')
+
+  const res = await fetch(`${base}/api/internal/v1/live-drafts`, {
+    headers: identityHeaders(input),
+    cache: 'no-store',
+  })
+  if (!res.ok) {
+    const body = (await res.json().catch(() => ({}))) as { error?: string }
+    throw new Error(body.error ?? `Admin live draft list failed (${res.status})`)
+  }
+  return (await res.json()) as CaptainDraftListResponse
+}
+
+export async function fetchCaptainDraftSnapshot(input: {
+  email: string
+  accountId?: string | null
+  eventId: string
+}) {
+  const base = readAdminApiBaseUrl()
+  if (!base) throw new Error('Admin API base URL is not configured')
+
+  const res = await fetch(`${base}/api/internal/v1/live-drafts/${input.eventId}`, {
+    headers: identityHeaders(input),
+    cache: 'no-store',
+  })
+  if (res.status === 403) {
+    throw new Error('You are not a captain for this event')
+  }
+  if (!res.ok) {
+    const body = (await res.json().catch(() => ({}))) as { error?: string }
+    throw new Error(body.error ?? `Failed to load draft (${res.status})`)
+  }
+  return res.json()
+}
+
+export async function postCaptainDraftPick(input: {
+  email: string
+  accountId?: string | null
+  eventId: string
+  registrationId: string
+}) {
+  const base = readAdminApiBaseUrl()
+  if (!base) throw new Error('Admin API base URL is not configured')
+
+  const res = await fetch(`${base}/api/internal/v1/live-drafts/${input.eventId}/picks`, {
+    method: 'POST',
+    headers: {
+      ...identityHeaders(input),
+      'Content-Type': 'application/json',
+    },
+    body: JSON.stringify({ registrationId: input.registrationId }),
+    cache: 'no-store',
+  })
+  if (!res.ok) {
+    const body = (await res.json().catch(() => ({}))) as { error?: string }
+    throw new Error(body.error ?? `Pick failed (${res.status})`)
+  }
+  return res.json()
+}
