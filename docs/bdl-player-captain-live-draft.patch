+'use client'
+
+import Link from 'next/link'
+import { useParams } from 'next/navigation'
+import { useCallback, useEffect, useMemo, useState } from 'react'
+
+type PoolPlayer = {
+  registrationId: string
+  displayName: string
+  genderLabel: string
+  skillLabel: string
+  photoUrl: string | null
+}
+
+type TeamRoster = {
+  draftGroup: number
+  teamName: string
+  requirements: {
+    womenNbCount: number
+    womenNbRequired: number
+    intermediateCount: number
+    intermediateRequired: number
+  }
+  players: Array<PoolPlayer & { pickNumber: number | null }>
+}
+
+type DraftSnapshot = {
+  eventName: string
+  status: string
+  viewer: { draftGroup: number | null; isCaptain: boolean }
+  turn: {
+    pickIndex: number
+    draftGroup: number
+    teamName: string
+    isComplete: boolean
+  } | null
+  pool: PoolPlayer[]
+  teams: TeamRoster[]
+}
+
+export default function DraftRoomPage() {
+  const params = useParams<{ eventId: string }>()
+  const eventId = params.eventId
+  const [snapshot, setSnapshot] = useState<DraftSnapshot | null>(null)
+  const [error, setError] = useState<string | null>(null)
+  const [filter, setFilter] = useState('')
+  const [picking, setPicking] = useState(false)
+
+  const load = useCallback(async () => {
+    const res = await fetch(`/api/drafts/${eventId}`)
+    if (!res.ok) {
+      const body = (await res.json().catch(() => ({}))) as { error?: string }
+      throw new Error(body.error ?? 'Failed to load draft')
+    }
+    setSnapshot((await res.json()) as DraftSnapshot)
+  }, [eventId])
+
+  useEffect(() => {
+    void load().catch((err) => setError(err instanceof Error ? err.message : 'Failed'))
+    const id = window.setInterval(() => {
+      void load().catch(() => {})
+    }, 1500)
+    return () => window.clearInterval(id)
+  }, [load])
+
+  const filteredPool = useMemo(() => {
+    const q = filter.trim().toLowerCase()
+    if (!snapshot?.pool) return []
+    if (!q) return snapshot.pool
+    return snapshot.pool.filter(
+      (p) =>
+        p.displayName.toLowerCase().includes(q) ||
+        p.genderLabel.toLowerCase().includes(q) ||
+        p.skillLabel.toLowerCase().includes(q)
+    )
+  }, [snapshot?.pool, filter])
+
+  const onClock =
+    snapshot?.status === 'live' &&
+    snapshot.turn &&
+    !snapshot.turn.isComplete &&
+    snapshot.viewer.draftGroup === snapshot.turn.draftGroup
+
+  async function pick(registrationId: string) {
+    setPicking(true)
+    setError(null)
+    try {
+      const res = await fetch(`/api/drafts/${eventId}/pick`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ registrationId }),
+      })
+      if (!res.ok) {
+        const body = (await res.json().catch(() => ({}))) as { error?: string }
+        throw new Error(body.error ?? 'Pick failed')
+      }
+      setSnapshot((await res.json()) as DraftSnapshot)
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Pick failed')
+    } finally {
+      setPicking(false)
+    }
+  }
+
+  const myTeam = snapshot?.teams.find((t) => t.draftGroup === snapshot.viewer.draftGroup)
+
+  return (
+    <main className="mx-auto max-w-5xl px-4 py-8">
+      <div className="mb-4 flex items-center justify-between gap-3">
+        <div>
+          <Link href="/drafts" className="text-sm text-teal-800 hover:underline">
+            ← All drafts
+          </Link>
+          <h1 className="mt-1 text-2xl font-semibold text-gray-900">
+            {snapshot?.eventName ?? 'Draft room'}
+          </h1>
+        </div>
+        {snapshot?.turn && !snapshot.turn.isComplete ? (
+          <div className="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">
+            On the clock: <span className="font-semibold">{snapshot.turn.teamName}</span>
+          </div>
+        ) : null}
+      </div>
+
+      {error ? <p className="mb-4 text-sm text-red-700">{error}</p> : null}
+
+      {myTeam ? (
+        <div className="mb-6 rounded-lg border border-teal-100 bg-teal-50/50 p-4 text-sm">
+          <div className="font-medium text-teal-950">Your team: {myTeam.teamName}</div>
+          <div className="mt-1 text-teal-900">
+            W/NB {myTeam.requirements.womenNbCount}/{myTeam.requirements.womenNbRequired} ·
+            Intermediate {myTeam.requirements.intermediateCount}/
+            {myTeam.requirements.intermediateRequired}
+          </div>
+        </div>
+      ) : null}
+
+      <div className="grid gap-6 lg:grid-cols-2">
+        <section className="rounded-lg border bg-white p-4 shadow-sm">
+          <h2 className="font-medium text-gray-900">Available players</h2>
+          <input
+            type="search"
+            placeholder="Search name, gender, skill…"
+            className="mt-2 w-full rounded border px-3 py-2 text-sm"
+            value={filter}
+            onChange={(e) => setFilter(e.target.value)}
+          />
+          <ul className="mt-3 max-h-[28rem] space-y-3 overflow-y-auto">
+            {filteredPool.map((p) => (
+              <li
+                key={p.registrationId}
+                className="flex gap-3 rounded border border-gray-100 p-2"
+              >
+                {p.photoUrl ? (
+                  <img
+                    src={p.photoUrl}
+                    alt=""
+                    className="h-14 w-14 shrink-0 rounded object-cover"
+                  />
+                ) : (
+                  <div className="flex h-14 w-14 shrink-0 items-center justify-center rounded bg-gray-100 text-xs text-gray-500">
+                    No photo
+                  </div>
+                )}
+                <div className="min-w-0 flex-1">
+                  <div className="font-medium text-gray-900">{p.displayName}</div>
+                  <div className="text-xs text-gray-600">
+                    {p.genderLabel} · {p.skillLabel}
+                  </div>
+                  {onClock ? (
+                    <button
+                      type="button"
+                      disabled={picking}
+                      className="mt-2 rounded bg-teal-700 px-3 py-1 text-xs font-medium text-white disabled:opacity-50"
+                      onClick={() => void pick(p.registrationId)}
+                    >
+                      Draft player
+                    </button>
+                  ) : null}
+                </div>
+              </li>
+            ))}
+          </ul>
+        </section>
+
+        <section className="rounded-lg border bg-white p-4 shadow-sm">
+          <h2 className="font-medium text-gray-900">All teams</h2>
+          <ul className="mt-3 max-h-[28rem] space-y-3 overflow-y-auto text-sm">
+            {snapshot?.teams.map((team) => (
+              <li key={team.draftGroup} className="rounded border border-gray-100 p-2">
+                <div className="font-medium">{team.teamName}</div>
+                <div className="text-xs text-gray-500">
+                  W/NB {team.requirements.womenNbCount}/{team.requirements.womenNbRequired} · Int{' '}
+                  {team.requirements.intermediateCount}/{team.requirements.intermediateRequired}
+                </div>
+                <ul className="mt-1 space-y-1 text-xs text-gray-700">
+                  {team.players.map((pl) => (
+                    <li key={pl.registrationId}>{pl.displayName}</li>
+                  ))}
+                </ul>
+              </li>
+            ))}
+          </ul>
+        </section>
+      </div>
+    </main>
+  )
+}
